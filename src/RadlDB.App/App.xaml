<!--
  Einstiegspunkt der WPF-Anwendung RadlDB.
  StartupUri legt fest, welches Fenster beim Programmstart automatisch geöffnet wird.
-->
<Application x:Class="RadlDB.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/Hauptfenster.xaml">
    <Application.Resources>
        <!-- Anwendungsweite Ressourcen (Farben, Stile) werden hier ab den folgenden Phasen ergänzt. -->
    </Application.Resources>
</Application>
