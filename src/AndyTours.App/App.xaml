<!--
  Einstiegspunkt der WPF-Anwendung AndyTours.
  Der Programmstart läuft über das Ereignis Startup (App.xaml.cs): Erst wird der Datenordner
  ermittelt und geprüft, danach das Hauptfenster geöffnet.
  ShutdownMode="OnExplicitShutdown": Rückfragen vor dem Hauptfenster (z. B. „Datenordner nicht
  erreichbar“) dürfen die App beim Schließen nicht beenden. Nach dem Öffnen des Hauptfensters
  wird auf „beim Schließen des Hauptfensters beenden“ umgestellt.
-->
<Application x:Class="AndyTours.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="AnwendungStartet"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Anwendungsweite Ressourcen (Farben, Stile) werden hier später ergänzt. -->
    </Application.Resources>
</Application>
