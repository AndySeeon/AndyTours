<!--
  Tabelle der Trainingseinheiten (Inhalt der Karteikarte „Trainingseinheiten“ im Hauptfenster).

  Aufbau:
    - Oben, immer sichtbar: Filterleiste (Kategorie, Equipment, Trainingsbereich, Distanz von–bis,
      Höhenmeter von–bis, Suche in Name und Kommentar, „Filter zurücksetzen“). Datenquelle ist Filter (EinheitenfilterViewModel);
      jede Eingabe wirkt sofort. Ungültige Zahlenfelder erhalten einen roten Rand, die Schaltfläche
      „Filter zurücksetzen“ ist hervorgehoben, solange ein Filter gesetzt ist.
    - Bei Einheiten in Auswahl und Filter:
        1. Tabelle (DataGrid) mit 18 Spalten, eine Zeile je Einheit; Klick auf eine Überschrift sortiert,
           Ziehen einer Überschrift verschiebt die Spalte, Rechtsklick auf die Überschriften öffnet das
           Menü zum Ein- und Ausblenden der Spalten (bleibt für mehrere Klicks offen)
        2. Summenzeile fest am unteren Rand: Anzahl unter „Name“, Summen unter Distanz, Höhenmeter und
           Fahrzeit. Ihre Zellen werden im Code-Behind erzeugt und an Breite, Sichtbarkeit und
           Reihenfolge der Tabellenspalten sowie an das waagrechte Blättern gekoppelt; die Spalten mit
           Summe sind nie schmaler als ihre Summe.

  Reihenfolge und Breite der Spalten werden in der Datenbank gemerkt (siehe Code-Behind).

  Bearbeiten:
    - Doppelklick auf eine Zeile öffnet das Bearbeitungsfenster; Rechtsklick öffnet das Menü mit
      Neue Einheit, Bearbeiten, Kopieren und Löschen; Entf löscht die markierten Einheiten.
    - F2, Klick in die schon markierte Zelle oder Lostippen bearbeitet den Wert direkt in der Zelle
      (alle Spalten außer Ø km/h, Kategorien und Kommentar; der Kommentar wird im Bearbeitungsfenster geändert). Aktivität, Equipment und Trainingsbereich werden aus
      einer Auswahlliste gewählt. Enter oder Verlassen der Zelle speichert sofort, Esc verwirft.
      Ein ungültiger Wert färbt die Zelle rot, sie bleibt dann in Bearbeitung (siehe Code-Behind).
    - Ohne Einheiten: nur der Hinweis „Keine Einheiten in dieser Auswahl.“ bzw. „Keine Einheiten passen
      zum Filter.“ (Hinweistext)

  Datenquelle ist das HauptfensterViewModel (vom Hauptfenster geerbt). Die Werte der Zeilen sind
  typisiert (Zahl, Datum, Dauer), damit richtig sortiert wird; das deutsche Format entsteht über
  Language="de-DE" und StringFormat. Bestwerte der Auswahl (Distanz, Höhenmeter, Fahrzeit, Ø km/h,
  max km/h) erscheinen rot.
-->
<UserControl x:Class="AndyTours.App.Views.EinheitenTabelle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AndyTours.App.Views"
             Language="de-DE">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />

        <!-- Zahlen rechtsbündig -->
        <Style x:Key="Zahl" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- Bestwerte: rot, sobald der Merker der Zeile gesetzt ist -->
        <Style x:Key="BestDistanz" TargetType="TextBlock" BasedOn="{StaticResource Zahl}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstBestDistanz}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BestHoehenmeter" TargetType="TextBlock" BasedOn="{StaticResource Zahl}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstBestHoehenmeter}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BestFahrzeit" TargetType="TextBlock" BasedOn="{StaticResource Zahl}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstBestFahrzeit}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BestDurchschnittKmh" TargetType="TextBlock" BasedOn="{StaticResource Zahl}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstBestDurchschnittKmh}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BestMaxKmh" TargetType="TextBlock" BasedOn="{StaticResource Zahl}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstBestMaxKmh}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Spalten mit Auswahlliste (Aktivität, Equipment, Trainingsbereich): Anzeige als Text ... -->
        <DataTemplate x:Key="AuswahlAnzeigeAktivitaet">
            <TextBlock Text="{Binding Aktivitaet, Mode=OneWay}" Margin="2,0" />
        </DataTemplate>
        <DataTemplate x:Key="AuswahlAnzeigeEquipment">
            <TextBlock Text="{Binding Equipment, Mode=OneWay}" Margin="2,0" />
        </DataTemplate>
        <DataTemplate x:Key="AuswahlAnzeigeTrainingsbereich">
            <TextBlock Text="{Binding Trainingsbereich, Mode=OneWay}" Margin="2,0" />
        </DataTemplate>
        <!-- ... und beim Bearbeiten eine Auswahlliste ohne Eintippen; Einträge und Wahl setzt der Code-Behind -->
        <DataTemplate x:Key="AuswahlBearbeiten">
            <ComboBox IsEditable="False" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" />
        </DataTemplate>

        <!-- Kontextmenü der Spaltenüberschriften; die Einträge werden beim Öffnen im Code-Behind erzeugt -->
        <ContextMenu x:Key="Spaltenmenue" Opened="Spaltenmenue_Opened" />

        <!-- Filterleiste: Beschriftung und Abstände -->
        <Style x:Key="FilterBeschriftung" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,4,0" />
        </Style>
        <Style x:Key="FilterAuswahl" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Zahlenfeld der Filterleiste; Rot und Tooltip setzt der jeweilige DataTrigger im Feld -->
        <Style x:Key="FilterZahl" TargetType="TextBox">
            <Setter Property="Width" Value="56" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Schaltfläche „Filter zurücksetzen“: hervorgehoben, solange ein Filter gesetzt ist.
             Die Schaltfläche liegt in der Filterleiste, deren DataContext schon der Filter ist – daher „IstGesetzt“. -->
        <Style x:Key="FilterZuruecksetzenStil" TargetType="Button">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstGesetzt}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="#FFFFD966" />
                    <Setter Property="BorderBrush" Value="#FFC09000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Filterleiste, immer sichtbar (auch bei leerer Auswahl, damit sich die Filter zurücksetzen lassen) -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,6" DataContext="{Binding Filter}">
            <TextBlock Text="Kategorie:" Style="{StaticResource FilterBeschriftung}" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding Kategorien}" SelectedItem="{Binding Kategorie}" Style="{StaticResource FilterAuswahl}" />

            <TextBlock Text="Equipment:" Style="{StaticResource FilterBeschriftung}" />
            <ComboBox ItemsSource="{Binding Equipments}" SelectedItem="{Binding Equipment}" Style="{StaticResource FilterAuswahl}" />

            <TextBlock Text="Bereich:" Style="{StaticResource FilterBeschriftung}" />
            <ComboBox ItemsSource="{Binding Trainingsbereiche}" SelectedItem="{Binding Trainingsbereich}" Style="{StaticResource FilterAuswahl}"
                      MinWidth="70" />

            <TextBlock Text="km von" Style="{StaticResource FilterBeschriftung}" />
            <TextBox Text="{Binding DistanzVon, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource FilterZahl}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DistanzVonFehlerhaft}" Value="True">
                                <Setter Property="BorderBrush" Value="Red" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Background" Value="#FFFFE0E0" />
                                <Setter Property="ToolTip" Value="Keine gültige Zahl oder „von“ größer als „bis“ – dieser Filter wirkt nicht." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="bis" Style="{StaticResource FilterBeschriftung}" Margin="4,0" />
            <TextBox Text="{Binding DistanzBis, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource FilterZahl}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DistanzBisFehlerhaft}" Value="True">
                                <Setter Property="BorderBrush" Value="Red" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Background" Value="#FFFFE0E0" />
                                <Setter Property="ToolTip" Value="Keine gültige Zahl oder „von“ größer als „bis“ – dieser Filter wirkt nicht." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock Text="hm von" Style="{StaticResource FilterBeschriftung}" />
            <TextBox Text="{Binding HoehenmeterVon, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource FilterZahl}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HoehenmeterVonFehlerhaft}" Value="True">
                                <Setter Property="BorderBrush" Value="Red" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Background" Value="#FFFFE0E0" />
                                <Setter Property="ToolTip" Value="Keine gültige Zahl oder „von“ größer als „bis“ – dieser Filter wirkt nicht." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="bis" Style="{StaticResource FilterBeschriftung}" Margin="4,0" />
            <TextBox Text="{Binding HoehenmeterBis, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource FilterZahl}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HoehenmeterBisFehlerhaft}" Value="True">
                                <Setter Property="BorderBrush" Value="Red" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Background" Value="#FFFFE0E0" />
                                <Setter Property="ToolTip" Value="Keine gültige Zahl oder „von“ größer als „bis“ – dieser Filter wirkt nicht." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock Text="Suche:" Style="{StaticResource FilterBeschriftung}" />
            <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}" Width="140" VerticalAlignment="Center" />

            <Button Content="Filter zurücksetzen" Command="{Binding FilterZuruecksetzenCommand}" Style="{StaticResource FilterZuruecksetzenStil}" />
        </WrapPanel>

        <Grid>
            <!-- Hinweis bei leerer Tabelle (leere Auswahl oder kein Treffer des Filters) -->
            <TextBlock Text="{Binding Hinweistext}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="Gray">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HatEinheiten}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DockPanel Visibility="{Binding HatEinheiten, Converter={StaticResource SichtbarWennWahr}}">

                <!-- 2. Summenzeile: Zellen siehe Code-Behind; der ScrollViewer folgt dem waagrechten Blättern der Tabelle -->
                <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,0,0" Background="#FFF0F0F0">
                    <ScrollViewer x:Name="SummenScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Summenzeile" Orientation="Horizontal" TextElement.FontWeight="Bold" Margin="0,3" />
                    </ScrollViewer>
                </Border>

                <!-- 1. Tabelle -->
                <DataGrid x:Name="Tabelle"
                          ItemsSource="{Binding Einheitszeilen}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserReorderColumns="True"
                          ColumnReordered="Tabelle_ColumnReordered"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#FFE0E0E0"
                          SelectionMode="Extended"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="False"
                          ScrollViewer.ScrollChanged="Tabelle_ScrollChanged"
                          SelectionChanged="Tabelle_SelectionChanged"
                          PreparingCellForEdit="Tabelle_PreparingCellForEdit"
                          CellEditEnding="Tabelle_CellEditEnding"
                          PreviewKeyDown="Tabelle_PreviewKeyDown"
                          PreviewMouseRightButtonDown="Tabelle_PreviewMouseRightButtonDown">
                    <!-- Rechtsklickmenü der Zeilen (die Überschriften haben ihr eigenes Spaltenmenü) -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Neue Einheit…" Command="{Binding NeueEinheitCommand}" InputGestureText="Strg+N" />
                            <MenuItem Header="_Bearbeiten…" Command="{Binding EinheitBearbeitenCommand}" />
                            <MenuItem Header="_Kopieren…" Command="{Binding EinheitKopierenCommand}" />
                            <MenuItem Header="_Tourdetail…" Command="{Binding TourdetailOeffnenCommand}" />
                            <Separator />
                            <MenuItem Header="Kategorien _zuordnen…" Command="{Binding KategorienZuordnenCommand}" />
                            <MenuItem Header="_Aktivität ändern…" Command="{Binding AktivitaetAendernCommand}" />
                            <MenuItem Header="_Equipment ändern…" Command="{Binding EquipmentAendernCommand}" />
                            <Separator />
                            <MenuItem Header="_Löschen" Command="{Binding EinheitenLoeschenCommand}" InputGestureText="Entf" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ContextMenu" Value="{StaticResource Spaltenmenue}" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <!-- Doppelklick auf eine Zeile öffnet das Bearbeitungsfenster -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="MouseDoubleClick" Handler="Zeile_MouseDoubleClick" />
                        </Style>
                    </DataGrid.RowStyle>
                    <!-- Alle Bindungen nur lesend (OneWay): geändert wird über das ViewModel, siehe Code-Behind.
                         Bearbeitbare Textspalten sind Zelltextspalten, weil sich DataGridTextColumn bei
                         OneWay-Bindung selbst sperrt. -->
                    <DataGrid.Columns>
                        <views:Zelltextspalte x:Name="SpalteDatum" Header="Datum" Binding="{Binding Datum, Mode=OneWay, StringFormat='ddd, dd.MM.yyyy'}" SortMemberPath="Datum" />
                        <views:Zelltextspalte x:Name="SpalteStartzeit" Header="Start" Binding="{Binding Startzeit, Mode=OneWay, StringFormat='HH:mm'}" SortMemberPath="Startzeit" />
                        <views:Zelltextspalte x:Name="SpalteName" Header="Name" Binding="{Binding Name, Mode=OneWay}" />
                        <DataGridTemplateColumn x:Name="SpalteAktivitaet" Header="Aktivität" SortMemberPath="Aktivitaet"
                                                CellTemplate="{StaticResource AuswahlAnzeigeAktivitaet}"
                                                CellEditingTemplate="{StaticResource AuswahlBearbeiten}" />
                        <DataGridTextColumn x:Name="SpalteKategorien" Header="Kategorien" Binding="{Binding Kategorien, Mode=OneWay}" IsReadOnly="True" />
                        <DataGridTemplateColumn x:Name="SpalteEquipment" Header="Equipment" SortMemberPath="Equipment"
                                                CellTemplate="{StaticResource AuswahlAnzeigeEquipment}"
                                                CellEditingTemplate="{StaticResource AuswahlBearbeiten}" />
                        <views:Zelltextspalte x:Name="SpalteDistanz" Header="km" Binding="{Binding DistanzKm, Mode=OneWay, StringFormat='N2'}"
                                            SortMemberPath="DistanzKm" ElementStyle="{StaticResource BestDistanz}" />
                        <views:Zelltextspalte x:Name="SpalteHoehenmeter" Header="hm" Binding="{Binding Hoehenmeter, Mode=OneWay, StringFormat='N0'}"
                                            SortMemberPath="Hoehenmeter" ElementStyle="{StaticResource BestHoehenmeter}" />
                        <views:Zelltextspalte x:Name="SpalteFahrzeit" Header="Fahrzeit" Binding="{Binding FahrzeitText, Mode=OneWay}"
                                            SortMemberPath="Fahrzeit" ElementStyle="{StaticResource BestFahrzeit}" />
                        <DataGridTextColumn x:Name="SpalteDurchschnittKmh" Header="Ø km/h" Binding="{Binding DurchschnittKmh, Mode=OneWay, StringFormat='N1'}"
                                            SortMemberPath="DurchschnittKmh" ElementStyle="{StaticResource BestDurchschnittKmh}" IsReadOnly="True" />
                        <views:Zelltextspalte x:Name="SpalteMaxKmh" Header="max km/h" Binding="{Binding MaxKmh, Mode=OneWay, StringFormat='N1'}"
                                            SortMemberPath="MaxKmh" ElementStyle="{StaticResource BestMaxKmh}" />
                        <views:Zelltextspalte x:Name="SpaltePulsDurchschnitt" Header="Ø Puls" Binding="{Binding HfDurchschnitt, Mode=OneWay}"
                                            SortMemberPath="HfDurchschnitt" ElementStyle="{StaticResource Zahl}" />
                        <views:Zelltextspalte x:Name="SpaltePulsMax" Header="max Puls" Binding="{Binding HfMax, Mode=OneWay}"
                                            SortMemberPath="HfMax" ElementStyle="{StaticResource Zahl}" />
                        <views:Zelltextspalte x:Name="SpalteTrittfrequenz" Header="Trittfrequenz" Binding="{Binding Trittfrequenz, Mode=OneWay}"
                                            SortMemberPath="Trittfrequenz" ElementStyle="{StaticResource Zahl}" />
                        <views:Zelltextspalte x:Name="SpalteTemperatur" Header="°C" Binding="{Binding Temperatur, Mode=OneWay}"
                                            SortMemberPath="Temperatur" ElementStyle="{StaticResource Zahl}" />
                        <views:Zelltextspalte x:Name="SpalteMaxHoehe" Header="max Höhe" Binding="{Binding MaxHoehe, Mode=OneWay, StringFormat='N0'}"
                                            SortMemberPath="MaxHoehe" ElementStyle="{StaticResource Zahl}" />
                        <DataGridTemplateColumn x:Name="SpalteTrainingsbereich" Header="Bereich" SortMemberPath="Trainingsbereich"
                                                CellTemplate="{StaticResource AuswahlAnzeigeTrainingsbereich}"
                                                CellEditingTemplate="{StaticResource AuswahlBearbeiten}" />
                        <DataGridTextColumn x:Name="SpalteKommentar" Header="Kommentar" Binding="{Binding Kommentar, Mode=OneWay}"
                                            SortMemberPath="Kommentar" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
