<!--
  Hauptfenster von AndyTours.

  Aufbau von oben nach unten (DockPanel):
    1. Menüleiste (Datei, Einheit, Extras, Hilfe); „Einheit → Neue Einheit“ auch mit Strg+N
    2. Werkzeugleiste mit Jahres- und Aktivitätsauswahl, daneben die Summen der Auswahl (Anzahl, km, hm)
    3. Statusleiste (am unteren Rand angedockt): links Gesamtzahl der Einheiten und die Meldung zur
       letzten Aktion (Statusmeldung), rechts der Datenordner
    4. Karteikarten mit den Arbeitsbereichen (füllt den restlichen Platz); „Aktuell“ zeigt
       Bestleistungen und Jahresfortschritt (AktuellAnsicht), „Trainingseinheiten“ die Tabelle der Einheiten der Auswahl
       (EinheitenTabelle), „Wartung“ Alarme und Wartungen der Räder (WartungenAnsicht; Titel mit der Anzahl
       fälliger Alarme)

  Alle Inhalte werden per Datenbindung aus dem HauptfensterViewModel gelesen.
  Das ViewModel wird beim Programmstart von App erzeugt und im Konstruktor übergeben.
  Die Karteikarten „Diagramme“, „Statistik“ und „Kalender“ des Originals entfallen (siehe
  specs/tourenverwaltung/map.md, „Nicht enthalten“).
-->
<Window x:Class="AndyTours.App.Views.Hauptfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AndyTours.App.Views"
        Title="{Binding Titel}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <!-- Tastenkürzel, die im ganzen Fenster gelten -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NeueEinheitCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- 1. Menüleiste -->
        <Menu DockPanel.Dock="Top">
            <!-- Import neuer Touren vom angeschlossenen Garmin-Gerät bzw. aus gewählten FIT-Dateien -->
            <MenuItem Header="_Datei">
                <MenuItem Header="Vom _Garmin importieren…" Command="{Binding VomGarminImportierenCommand}" />
                <MenuItem Header="_FIT-Dateien importieren…" Command="{Binding FitDateienImportierenCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Command="{Binding BeendenCommand}" InputGestureText="Alt+F4" />
            </MenuItem>
            <!-- Befehle für Trainingseinheiten; „Löschen“ per Entf-Taste wird in der Tabelle ausgewertet -->
            <MenuItem Header="_Einheit">
                <MenuItem Header="_Neue Einheit…" Command="{Binding NeueEinheitCommand}" InputGestureText="Strg+N" />
                <MenuItem Header="_Bearbeiten…" Command="{Binding EinheitBearbeitenCommand}" />
                <MenuItem Header="_Kopieren…" Command="{Binding EinheitKopierenCommand}" />
                <MenuItem Header="_Tourdetail…" Command="{Binding TourdetailOeffnenCommand}" />
                <Separator />
                <MenuItem Header="Kategorien _zuordnen…" Command="{Binding KategorienZuordnenCommand}" />
                <MenuItem Header="_Aktivität ändern…" Command="{Binding AktivitaetAendernCommand}" />
                <MenuItem Header="_Equipment ändern…" Command="{Binding EquipmentAendernCommand}" />
                <Separator />
                <MenuItem Header="_Löschen" Command="{Binding EinheitenLoeschenCommand}" InputGestureText="Entf" />
            </MenuItem>
            <MenuItem Header="E_xtras">
                <MenuItem Header="_Persönliche Daten…" Command="{Binding PersoenlicheDatenOeffnenCommand}" />
                <MenuItem Header="_Saisonziele…" Command="{Binding SaisonzieleOeffnenCommand}" />
                <MenuItem Header="E_quipment-Einsatz…" Command="{Binding EquipmentEinsatzOeffnenCommand}" />
                <MenuItem Header="_Einstellungen…" Command="{Binding EinstellungenOeffnenCommand}" />
                <Separator />
                <MenuItem Header="Sicherung _wiederherstellen…" Command="{Binding SicherungWiederherstellenCommand}" />
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Über AndyTours" Command="{Binding UeberCommand}" />
            </MenuItem>
        </Menu>

        <!-- 2. Werkzeugleiste: Filter für Jahr und Aktivität, wirken später auf alle Karteikarten -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Label Content="Jahr:" VerticalAlignment="Center" />
                <ComboBox Width="110"
                          ItemsSource="{Binding Jahre}"
                          SelectedItem="{Binding AusgewaehltesJahr}" />
                <Separator />
                <Label Content="Aktivität:" VerticalAlignment="Center" />
                <ComboBox Width="140"
                          ItemsSource="{Binding Aktivitaeten}"
                          SelectedItem="{Binding AusgewaehlteAktivitaet}" />
                <Separator />
                <!-- Summen der Auswahl bzw. Hinweis „Noch keine Touren vorhanden.“; ändern sich sofort mit der Auswahl -->
                <TextBlock Text="{Binding Summentext}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="8,0" />
            </ToolBar>
        </ToolBarTray>

        <!-- 3. Statusleiste -->
        <StatusBar DockPanel.Dock="Bottom">
            <!-- DockPanel als Anordnung: der Datenordner rechts, die Summen füllen den Rest -->
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding Datenordner, StringFormat='Datenordner: {0}'}" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <!-- Gesamtzahl links; daneben eine Meldung zur letzten Aktion (z. B. gespeichert außerhalb der Auswahl) -->
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding Statustext}" />
            </StatusBarItem>
            <!-- Meldung gelb hinterlegt, damit sie auffällt; ohne Meldung unsichtbar -->
            <StatusBarItem>
                <Border Background="#FFFFD966" BorderBrush="#FFC09000" BorderThickness="1" CornerRadius="2"
                        Padding="8,1" Margin="12,0,0,0" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Statusmeldung}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Statusmeldung}" FontWeight="Bold" />
                </Border>
            </StatusBarItem>
        </StatusBar>

        <!-- 4. Karteikarten (Reihenfolge wie im Original BikeXperience) -->
        <TabControl x:Name="Karteikarten" Margin="4">
            <TabItem Header="Aktuell">
                <views:AktuellAnsicht />
            </TabItem>
            <TabItem Header="Trainingseinheiten">
                <views:EinheitenTabelle x:Name="Einheiten" />
            </TabItem>
            <!-- IsSelected: auf dieser Karteikarte nennt die Statusleiste die Anzahl der Wartungen;
                 der Titel zeigt die Anzahl fälliger Alarme, z. B. „Wartung (2)“ -->
            <TabItem Header="{Binding WartungTitel}" IsSelected="{Binding IstWartungGewaehlt, Mode=OneWayToSource}">
                <views:WartungenAnsicht />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
