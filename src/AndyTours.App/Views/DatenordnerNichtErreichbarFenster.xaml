<!--
  Meldung beim Programmstart, wenn der Datenordner nicht erreichbar ist (z. B. NAS ausgeschaltet).

  Aufbau von oben nach unten:
    1. Meldungstext mit dem Ordnerpfad
    2. Schaltflächen „Erneut versuchen“ (Standard), „Anderen Ordner wählen“, „Beenden“

  Ein eigenes Fenster statt MessageBox, weil die Standard-Meldung keine eigenen
  Beschriftungen der Schaltflächen erlaubt. Das Schließen über das X gilt als „Beenden“.
-->
<Window x:Class="AndyTours.App.Views.DatenordnerNichtErreichbarFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AndyTours – Datenordner nicht erreichbar"
        SizeToContent="WidthAndHeight"
        MaxWidth="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <StackPanel Margin="16">

        <!-- 1. Meldungstext -->
        <TextBlock x:Name="Meldung" TextWrapping="Wrap" Margin="0,0,0,16" />

        <!-- 2. Schaltflächen -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Erneut versuchen" IsDefault="True" MinWidth="120" Padding="8,3" Margin="0,0,8,0"
                    Click="ErneutVersuchen_Click" />
            <Button Content="_Anderen Ordner wählen…" MinWidth="120" Padding="8,3" Margin="0,0,8,0"
                    Click="AndererOrdner_Click" />
            <Button Content="_Beenden" IsCancel="True" MinWidth="90" Padding="8,3"
                    Click="Beenden_Click" />
        </StackPanel>

    </StackPanel>
</Window>
