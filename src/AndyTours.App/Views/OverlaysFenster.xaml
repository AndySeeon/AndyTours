<!--
  Fenster „Overlays“ (Menü „Tourenplanung → Overlays…“): gespeicherte Strecken in Ordnern verwalten und auf den Karten
  einblenden.

  Aufbau von oben nach unten:
    1. Leiste: „Ordner anlegen“, „GPX hinzufügen…“, „Verschieben nach…“, „Löschen“
    2. Unten (immer sichtbar, ohne Markierung bzw. bei einem Ordner ohne Farbe gesperrt, mit grauem Hinweis):
       Name des markierten Ordners bzw. Overlays mit „Übernehmen“ (auch Eingabetaste; speichert den Namen und
       schließt das Fenster, bei einem abgewiesenen Namen bleibt es offen), bei einem Overlay die
       Farbe („Gemeinsame Farbe (…)“ oder eine der zwölf Farben), ein roter Hinweis und ein Bedienhinweis
    3. Baum der Ordner und Overlays mit Kontrollkästchen zum Einblenden (bei Ordnern für den ganzen Inhalt, gefüllt bei
       teilweise eingeblendetem Inhalt) und einem Farbfeld je Overlay; ohne Overlays darunter ein Hinweis

  Dieselben Befehle stehen im Kontextmenü des Baums. Jede Änderung wird sofort gespeichert und gilt sofort auf allen
  offenen Karten. Das Fenster ist nicht modal und nur einmal geöffnet.
-->
<Window x:Class="AndyTours.App.Views.OverlaysFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AndyTours.App.ViewModels"
        Title="Overlays"
        Width="460"
        Height="600"
        MinWidth="360"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />

        <ContextMenu x:Key="Baummenue">
            <MenuItem Header="_Ordner anlegen" Command="{Binding OrdnerAnlegenCommand}" />
            <MenuItem Header="_GPX hinzufügen…" Command="{Binding GpxHinzufuegenCommand}" />
            <Separator />
            <MenuItem Header="_Verschieben nach…" Command="{Binding VerschiebenCommand}" />
            <MenuItem Header="_Löschen" Command="{Binding LoeschenCommand}" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel Margin="8">

        <!-- 1. Leiste -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="_Ordner anlegen" Padding="8,3" Command="{Binding OrdnerAnlegenCommand}" />
            <Button Content="_GPX hinzufügen…" Padding="8,3" Margin="6,0,0,0" Command="{Binding GpxHinzufuegenCommand}" />
            <Button Content="_Verschieben nach…" Padding="8,3" Margin="6,0,0,0" Command="{Binding VerschiebenCommand}" />
            <Button Content="_Löschen" Padding="8,3" Margin="6,0,0,0" Command="{Binding LoeschenCommand}" />
        </WrapPanel>

        <!-- 2. Name, Farbe, Hinweise -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="_Name:" Target="{Binding ElementName=NamensFeld}" VerticalAlignment="Center" />
                <TextBox x:Name="NamensFeld" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center"
                         IsEnabled="{Binding IstEtwasAusgewaehlt}"
                         Text="{Binding Bearbeitungsname, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding NameUebernehmenCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Row="0" Grid.Column="2" Content="Ü_bernehmen" Padding="8,3" Margin="6,0,0,0"
                        Command="{Binding NameUebernehmenCommand}" />

                <Label Grid.Row="1" Grid.Column="0" Content="_Farbe:" Target="{Binding ElementName=FarbFeld}" VerticalAlignment="Center"
                       Margin="0,4,0,0" />
                <ComboBox x:Name="FarbFeld" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                          ItemsSource="{Binding Farbauswahl}" SelectedItem="{Binding GewaehlteFarbe}"
                          IsEnabled="{Binding IstOverlayAusgewaehlt}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="24" Height="10" Fill="{Binding Pinsel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <TextBlock Text="{Binding Auswahlhinweis}" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Hinweis}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Kontrollkästchen: auf den Karten einblenden · Doppelklick auf ein Overlay: ganze Strecke auf den Karten zeigen" />
        </StackPanel>

        <!-- 3. Baum; ohne Overlays mit Hinweis darunter -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding LeerhinweisText}" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding IstLeer, Converter={StaticResource SichtbarWennWahr}}" />
            <TreeView x:Name="Baum" ItemsSource="{Binding Wurzeln}" ContextMenu="{StaticResource Baummenue}"
                      PreviewMouseRightButtonDown="Baum_PreviewMouseRightButtonDown"
                      MouseDoubleClick="Baum_MouseDoubleClick">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IstAufgeklappt, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IstAusgewaehlt, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:Overlayknoten}" ItemsSource="{Binding Kinder}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <CheckBox IsChecked="{Binding IstEingeschaltet}" VerticalAlignment="Center" Focusable="False" />
                            <Rectangle Width="18" Height="6" Fill="{Binding Farbe}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IstOverlay, Converter={StaticResource SichtbarWennWahr}}" />
                            <TextBlock Text="📁" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IstOrdner, Converter={StaticResource SichtbarWennWahr}}" />
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

    </DockPanel>
</Window>
