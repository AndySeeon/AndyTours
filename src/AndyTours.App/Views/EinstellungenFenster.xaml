<!--
  Einstellungen von AndyTours (Menü „Extras → Einstellungen…“).

  Aufbau: vier Karteikarten, darunter fest die Schaltfläche „Schließen“
    1. Karteikarte „Allgemein“
       a) Gruppe „Datenordner“: vollständiger Pfad (nur lesbar) und Schaltfläche „Ändern…“
       b) Hinweis, warum der Ordner in der Entwicklungsversion nicht änderbar ist (nur dort sichtbar)
       c) Gruppe „Darstellung“: Größe der Oberfläche in festen Stufen von 100 % bis 200 %; gilt sofort in allen
          offenen Fenstern (Spezifikation 035, docs/adr/0007-skalierung-der-oberflaeche.md)
    2. Karteikarte „Datensicherung“: Sicherungsordner mit „Ändern…“, Intervall (Programmstarts) und Höchstzahl der
       Sicherungen, jeweils mit Hinweis bei ungültiger Eingabe (erlaubt 1 bis 99)
    3. Karteikarte „Tourenplanung“
       a) Gruppe „Routing“: Wahl des Dienstes (BRouter oder openrouteservice), Adresse des BRouter-Servers mit
          Hinweis bei ungültiger Adresse, Zugangsschlüssel für openrouteservice als maskiertes Feld mit Hinweis,
          wenn er fehlt (siehe docs/adr/0004-routingdienst.md)
       b) Gruppe „Overlays“: gemeinsame Farbe aller Overlays ohne eigene Farbe (Auswahl aus zwölf Farben,
          voreingestellt Violett)
    4. Karteikarte „Auswahllisten“: Auswahl der Liste („Trainingsbereich“, „Aktivität“, „Kategorie“, „Equipment“),
       deren Einträge mit „Nach oben“, „Nach unten“ (bei Kategorien und Equipments nicht wählbar, sie stehen
       alphabetisch) und „Löschen“, dazu nur bei Aktivitäten „Als Hauptaktivität“, nur bei Kategorien
       „Standard“, bei beiden „Zusammenführen mit …“ und nur bei Equipments „Bearbeiten…“ (auch Doppelklick);
       darunter das Eingabefeld „Eintrag“ mit „Hinzufügen“ und „Umbenennen“ (bei Equipments nur „Hinzufügen“,
       das das Fenster „Equipment“ öffnet) und ein roter Hinweis bei abgewiesenen Eingaben oder gesperrtem Löschen
    5. Schaltfläche „Schließen“

  Ein Ordnerwechsel gilt sofort nach Abschluss der Rückfragen; ein eigenes „OK“ ist nicht nötig.
  Ebenso werden Sicherungsordner, Intervall, Höchstzahl, die Routingeinstellungen, die Overlay-Farbe und die Größe
  der Oberfläche sofort gespeichert, sobald sie gültig sind.
-->
<Window x:Class="AndyTours.App.Views.EinstellungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="640"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />
    </Window.Resources>

    <!-- Feste Höhe, damit das Fenster beim Wechsel der Karteikarte nicht springt; reicht der Bildschirm nicht
         (große Oberfläche), begrenzt Oberflaechenskalierung die Höhe, die Karteikarte rollt, und „Schließen“
         bleibt unten immer sichtbar -->
    <DockPanel>

        <!-- 5. Schließen -->
        <Button DockPanel.Dock="Bottom" Content="_Schließen" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                MinWidth="90" Padding="8,3" Margin="16,12,16,16" />

        <TabControl Margin="16,16,16,0">

            <!-- 1. Allgemein -->
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- 1a. Datenordner -->
                        <GroupBox Header="Datenordner" Padding="8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="_Ändern…" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                                        Command="{Binding AendernCommand}" />
                                <TextBox Text="{Binding Datenordner, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                            </DockPanel>
                        </GroupBox>

                        <!-- 1b. Hinweis für die Entwicklungsversion -->
                        <TextBlock Text="{Binding Hinweis}" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                                   Visibility="{Binding HinweisSichtbar, Converter={StaticResource SichtbarWennWahr}}" />

                        <!-- 1c. Darstellung: Größe der Oberfläche; jede Wahl wird sofort gespeichert und gilt in allen offenen Fenstern -->
                        <GroupBox Header="Darstellung" Padding="8" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Größe _der Oberfläche:" Target="{Binding ElementName=GroesseFeld}" VerticalAlignment="Center" />
                                <ComboBox x:Name="GroesseFeld" Width="120" ItemsSource="{Binding Oberflaechenstufen}"
                                          SelectedItem="{Binding Oberflaechengroesse}" ItemStringFormat="{}{0} %" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Datensicherung -->
            <TabItem Header="Datensicherung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Werte gelten für den Datenordner auf der Karteikarte „Allgemein“ -->
                        <GroupBox Header="Datensicherung" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Sicherungs_ordner:" Target="{Binding ElementName=SicherungsordnerFeld}"
                                       VerticalAlignment="Center" />
                                <DockPanel Grid.Row="0" Grid.Column="1">
                                    <Button DockPanel.Dock="Right" Content="Ä_ndern…" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                                            Command="{Binding SicherungsordnerAendernCommand}" />
                                    <TextBox x:Name="SicherungsordnerFeld" Text="{Binding Sicherungsordner, Mode=OneWay}" IsReadOnly="True"
                                             VerticalContentAlignment="Center" />
                                </DockPanel>

                                <!-- Gültige Werte werden bei jeder Eingabe sofort gespeichert; ungültige nicht, dann erscheint der Hinweis -->
                                <Label Grid.Row="1" Grid.Column="0" Content="Sichern nach _Programmstarts:" Target="{Binding ElementName=IntervallFeld}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="IntervallFeld" Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                         Margin="0,8,0,0" VerticalContentAlignment="Center"
                                         Text="{Binding IntervallText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IntervallHinweis}" Foreground="Firebrick" TextWrapping="Wrap" />

                                <Label Grid.Row="3" Grid.Column="0" Content="_Höchstens aufbewahren:" Target="{Binding ElementName=HoechstzahlFeld}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox x:Name="HoechstzahlFeld" Width="60" VerticalContentAlignment="Center"
                                             Text="{Binding HoechstzahlText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Sicherungen (die ältesten werden gelöscht)" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HoechstzahlHinweis}" Foreground="Firebrick" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Die Sicherung erfolgt automatisch beim Programmstart." />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Tourenplanung -->
            <TabItem Header="Tourenplanung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- 3a. Routing: Dienst der Tourenplanung; Werte gelten für den Datenordner auf der Karteikarte „Allgemein“ -->
                        <GroupBox Header="Routing" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <RadioButton Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" GroupName="Routingdienst"
                                             Content="BRouter (_kostenlos, ohne Zugangsschlüssel)" IsChecked="{Binding IstBRouter}" />
                                <Label Grid.Row="1" Grid.Column="0" Content="Server_adresse:" Target="{Binding ElementName=AdressFeld}"
                                       VerticalAlignment="Center" Margin="16,4,0,0" />
                                <TextBox x:Name="AdressFeld" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" VerticalContentAlignment="Center"
                                         Text="{Binding BRouterAdresse, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AdressHinweis}" Foreground="Firebrick" TextWrapping="Wrap" />

                                <RadioButton Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" GroupName="Routingdienst" Margin="0,8,0,0"
                                             Content="open_routeservice (mit Zugangsschlüssel)" IsChecked="{Binding IstOpenrouteservice}" />
                                <!-- Der Schlüssel ist geheim: maskiertes Feld, gefüllt und gemeldet vom Code-Behind -->
                                <Label Grid.Row="4" Grid.Column="0" Content="Zu_gangsschlüssel:" Target="{Binding ElementName=SchluesselFeld}"
                                       VerticalAlignment="Top" Margin="16,4,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,0">
                                    <PasswordBox x:Name="SchluesselFeld" VerticalContentAlignment="Center" PasswordChanged="SchluesselFeld_PasswordChanged" />
                                    <TextBlock Text="{Binding RoutingHinweis}" Foreground="Firebrick" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- 3b. Overlays: gemeinsame Farbe aller Overlays ohne eigene Farbe; gilt sofort auf allen offenen Karten -->
                        <GroupBox Header="Overlays" Padding="8" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Gemeinsame _Farbe:" Target="{Binding ElementName=OverlayfarbeFeld}" VerticalAlignment="Center" />
                                <ComboBox x:Name="OverlayfarbeFeld" Width="180" ItemsSource="{Binding Overlayfarben}" SelectedItem="{Binding Overlayfarbe}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="24" Height="10" Fill="{Binding Pinsel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. Auswahllisten: feste Werte der Eingabefelder; jede Änderung wird sofort gespeichert -->
            <TabItem Header="Auswahllisten">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16" DataContext="{Binding Auswahllisten}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="_Liste:" Target="{Binding ElementName=ListenAuswahl}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ListenAuswahl" Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Listen}" SelectedItem="{Binding GewaehlteListe}" />

                        <!-- Einträge in der Reihenfolge der Anzeige, mit Zusatz „(Hauptaktivität)“ bzw. „(Standard)“;
                             ein Klick übernimmt den Eintrag ins Eingabefeld -->
                        <ListBox Grid.Row="1" Grid.Column="1" Height="300" Margin="0,8,0,0"
                                 ItemsSource="{Binding Eintraege}" DisplayMemberPath="Anzeige" SelectedIndex="{Binding GewaehlterIndex}"
                                 MouseDoubleClick="Eintrag_MouseDoubleClick">
                            <!-- Fluent-Listeneinträge sind hoch; kompakter passen mehr Einträge ohne Bildlauf hinein -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,8,0,0">
                            <Button Content="Nach _oben" MinWidth="90" Padding="8,3" Command="{Binding NachObenCommand}" />
                            <Button Content="Nach _unten" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding NachUntenCommand}" />
                            <Button Content="_Löschen" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding LoeschenCommand}" />
                            <Button Content="Als Hauptakti_vität" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding AlsHauptaktivitaetCommand}"
                                    Visibility="{Binding IstAktivitaetsliste, Converter={StaticResource SichtbarWennWahr}}" />
                            <Button Content="S_tandard" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding StandardCommand}"
                                    Visibility="{Binding IstKategorienliste, Converter={StaticResource SichtbarWennWahr}}" />
                            <Button Content="_Zusammenführen mit…" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding ZusammenfuehrenCommand}"
                                    Visibility="{Binding KannZusammenfuehrenAnzeigen, Converter={StaticResource SichtbarWennWahr}}" />
                            <Button Content="_Bearbeiten…" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding BearbeitenCommand}"
                                    Visibility="{Binding IstEquipmentliste, Converter={StaticResource SichtbarWennWahr}}" />
                        </StackPanel>

                        <!-- Bei Equipments ohne Eingabefeld und „Umbenennen“: Name und übrige Felder stehen im Fenster „Equipment“ -->
                        <Label Grid.Row="2" Grid.Column="0" Content="_Eintrag:" Target="{Binding ElementName=EintragFeld}"
                               VerticalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding HatEingabefeld, Converter={StaticResource SichtbarWennWahr}}" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="_Umbenennen" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                                    Command="{Binding UmbenennenCommand}"
                                    Visibility="{Binding HatEingabefeld, Converter={StaticResource SichtbarWennWahr}}" />
                            <Button DockPanel.Dock="Right" Content="_Hinzufügen" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                                    Command="{Binding HinzufuegenCommand}" />
                            <TextBox x:Name="EintragFeld" VerticalContentAlignment="Center"
                                     Text="{Binding Eingabe, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding HatEingabefeld, Converter={StaticResource SichtbarWennWahr}}" />
                        </DockPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Hinweis}" Foreground="Firebrick" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
