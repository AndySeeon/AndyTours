<!--
  Einstellungen von AndyTours (Menü „Extras → Einstellungen…“).

  Aufbau von oben nach unten:
    1. Gruppe „Datenordner“: vollständiger Pfad (nur lesbar) und Schaltfläche „Ändern…“
    2. Hinweis, warum der Ordner in der Entwicklungsversion nicht änderbar ist (nur dort sichtbar)
    3. Gruppe „Datensicherung“: Sicherungsordner mit „Ändern…“, Intervall (Programmstarts) und
       Höchstzahl der Sicherungen, jeweils mit Hinweis bei ungültiger Eingabe (erlaubt 1 bis 99)
    4. Gruppe „Auswahllisten“: Auswahl der Liste („Trainingsbereich“, „Aktivität“, „Kategorie“), deren
       Einträge mit „Nach oben“, „Nach unten“ (bei Kategorien nicht wählbar, sie stehen alphabetisch) und
       „Löschen“, dazu nur bei Aktivitäten „Als Hauptaktivität“, nur bei Kategorien „Standard“ und bei
       beiden „Zusammenführen mit …“; darunter das Eingabefeld „Eintrag“ mit „Hinzufügen“ und
       „Umbenennen“ und ein roter Hinweis bei abgewiesenen Eingaben oder gesperrtem Löschen
    5. Schaltfläche „Schließen“

  Ein Ordnerwechsel gilt sofort nach Abschluss der Rückfragen; ein eigenes „OK“ ist nicht nötig.
  Ebenso werden Sicherungsordner, Intervall und Höchstzahl sofort gespeichert, sobald sie gültig sind.
-->
<Window x:Class="AndyTours.App.Views.EinstellungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />
    </Window.Resources>

    <StackPanel Margin="16">

        <!-- 1. Datenordner -->
        <GroupBox Header="Datenordner" Padding="8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Ändern…" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                        Command="{Binding AendernCommand}" />
                <TextBox Text="{Binding Datenordner, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
        </GroupBox>

        <!-- 2. Hinweis für die Entwicklungsversion -->
        <TextBlock Text="{Binding Hinweis}" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                   Visibility="{Binding HinweisSichtbar, Converter={StaticResource SichtbarWennWahr}}" />

        <!-- 3. Datensicherung: Werte gelten für den oben angezeigten Datenordner -->
        <GroupBox Header="Datensicherung" Padding="8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Sicherungs_ordner:" Target="{Binding ElementName=SicherungsordnerFeld}"
                       VerticalAlignment="Center" />
                <DockPanel Grid.Row="0" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="Ä_ndern…" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                            Command="{Binding SicherungsordnerAendernCommand}" />
                    <TextBox x:Name="SicherungsordnerFeld" Text="{Binding Sicherungsordner, Mode=OneWay}" IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </DockPanel>

                <!-- Gültige Werte werden bei jeder Eingabe sofort gespeichert; ungültige nicht, dann erscheint der Hinweis -->
                <Label Grid.Row="1" Grid.Column="0" Content="Sichern nach _Programmstarts:" Target="{Binding ElementName=IntervallFeld}"
                       VerticalAlignment="Center" Margin="0,8,0,0" />
                <TextBox x:Name="IntervallFeld" Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                         Margin="0,8,0,0" VerticalContentAlignment="Center"
                         Text="{Binding IntervallText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IntervallHinweis}" Foreground="Firebrick" TextWrapping="Wrap" />

                <Label Grid.Row="3" Grid.Column="0" Content="_Höchstens aufbewahren:" Target="{Binding ElementName=HoechstzahlFeld}"
                       VerticalAlignment="Center" Margin="0,8,0,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="HoechstzahlFeld" Width="60" VerticalContentAlignment="Center"
                             Text="{Binding HoechstzahlText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Sicherungen (die ältesten werden gelöscht)" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HoechstzahlHinweis}" Foreground="Firebrick" TextWrapping="Wrap" />

                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Die Sicherung erfolgt automatisch beim Programmstart." />
            </Grid>
        </GroupBox>

        <!-- 4. Auswahllisten: feste Werte der Eingabefelder; jede Änderung wird sofort gespeichert -->
        <GroupBox Header="Auswahllisten" Padding="8" Margin="0,12,0,0" DataContext="{Binding Auswahllisten}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="_Liste:" Target="{Binding ElementName=ListenAuswahl}" VerticalAlignment="Center" />
                <ComboBox x:Name="ListenAuswahl" Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                          ItemsSource="{Binding Listen}" SelectedItem="{Binding GewaehlteListe}" />

                <!-- Einträge in der Reihenfolge der Anzeige, mit Zusatz „(Hauptaktivität)“ bzw. „(Standard)“;
                     ein Klick übernimmt den Eintrag ins Eingabefeld -->
                <ListBox Grid.Row="1" Grid.Column="1" MinHeight="150" Margin="0,8,0,0"
                         ItemsSource="{Binding Eintraege}" DisplayMemberPath="Anzeige" SelectedIndex="{Binding GewaehlterIndex}" />
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,8,0,0">
                    <Button Content="Nach _oben" MinWidth="90" Padding="8,3" Command="{Binding NachObenCommand}" />
                    <Button Content="Nach _unten" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding NachUntenCommand}" />
                    <Button Content="_Löschen" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding LoeschenCommand}" />
                    <Button Content="Als Hauptakti_vität" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding AlsHauptaktivitaetCommand}"
                            Visibility="{Binding IstAktivitaetsliste, Converter={StaticResource SichtbarWennWahr}}" />
                    <Button Content="S_tandard" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding StandardCommand}"
                            Visibility="{Binding IstKategorienliste, Converter={StaticResource SichtbarWennWahr}}" />
                    <Button Content="_Zusammenführen mit…" MinWidth="90" Padding="8,3" Margin="0,6,0,0" Command="{Binding ZusammenfuehrenCommand}"
                            Visibility="{Binding KannZusammenfuehrenAnzeigen, Converter={StaticResource SichtbarWennWahr}}" />
                </StackPanel>

                <Label Grid.Row="2" Grid.Column="0" Content="_Eintrag:" Target="{Binding ElementName=EintragFeld}"
                       VerticalAlignment="Center" Margin="0,8,0,0" />
                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="_Umbenennen" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                            Command="{Binding UmbenennenCommand}" />
                    <Button DockPanel.Dock="Right" Content="_Hinzufügen" MinWidth="90" Padding="8,3" Margin="8,0,0,0"
                            Command="{Binding HinzufuegenCommand}" />
                    <TextBox x:Name="EintragFeld" VerticalContentAlignment="Center"
                             Text="{Binding Eingabe, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Hinweis}" Foreground="Firebrick" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <!-- 5. Schließen -->
        <Button Content="_Schließen" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                MinWidth="90" Padding="8,3" Margin="0,16,0,0" />

    </StackPanel>
</Window>
