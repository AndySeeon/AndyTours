<!--
  Fenster „Garmin-Import“ für „Datei → Vom Garmin importieren…“ und „Datei → FIT-Dateien importieren…“.

  Aufbau von oben nach unten:
    1. Erklärung
    2. Tabelle der neuen Touren: Häkchen, Datum, Start, km, Fahrzeit, Profil, Gerät (nur bei mehreren
       Geräten sichtbar, siehe Code-Behind) und Equipment (Auswahlliste, änderbar)
    3. Schaltflächen „Importieren“ (nur mit mindestens einem Häkchen) und „Abbrechen“

  Das Fenster wählt nur aus. Ablegen, Speichern und Markieren folgen erst nach dem Schließen.
-->
<Window x:Class="AndyTours.App.Views.GarminImportFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garmin-Import"
        Width="760"
        Height="460"
        MinWidth="520"
        MinHeight="280"
        Language="de-DE"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- 1. Erklärung -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Diese Touren sind noch nicht in AndyTours. Angehakte Touren werden mit dem gewählten Equipment importiert:" />

        <!-- 3. Schaltflächen -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Importieren" IsDefault="True" MinWidth="110" Padding="8,3" Margin="0,0,8,0"
                    Command="{Binding ImportierenCommand}" />
            <Button Content="_Abbrechen" IsCancel="True" MinWidth="90" Padding="8,3" />
        </StackPanel>

        <!-- 2. Tabelle der neuen Touren -->
        <DataGrid ItemsSource="{Binding Zeilen}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Resources>
                <Style x:Key="Zahl" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Margin" Value="4,0" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <!-- Häkchen: Klick wirkt sofort, ohne die Zeile erst in den Bearbeitungsmodus zu bringen -->
                <DataGridTemplateColumn Header="Import" SortMemberPath="Importieren">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Importieren, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, Mode=OneWay, StringFormat='ddd, dd.MM.yyyy'}" IsReadOnly="True" />
                <DataGridTextColumn Header="Start" Binding="{Binding Startzeit, Mode=OneWay, StringFormat='HH:mm'}" IsReadOnly="True" />
                <DataGridTextColumn Header="km" Binding="{Binding DistanzKm, Mode=OneWay, StringFormat='N2'}" IsReadOnly="True"
                                    ElementStyle="{StaticResource Zahl}" />
                <DataGridTextColumn Header="Fahrzeit" Binding="{Binding FahrzeitText, Mode=OneWay}" SortMemberPath="Fahrzeit" IsReadOnly="True"
                                    ElementStyle="{StaticResource Zahl}" />
                <DataGridTextColumn Header="Profil" Binding="{Binding Profil, Mode=OneWay}" IsReadOnly="True" />
                <DataGridTextColumn x:Name="SpalteGeraet" Header="Gerät" Binding="{Binding Geraet, Mode=OneWay}" IsReadOnly="True" />
                <!-- Equipment: Auswahlliste aus dem ViewModel des Fensters -->
                <DataGridTemplateColumn Header="Equipment" Width="*" SortMemberPath="Equipment.Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="2,1"
                                      ItemsSource="{Binding DataContext.Equipments, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Equipment, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
