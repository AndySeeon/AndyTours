<!--
  Fenster „Über AndyTours“ (Menü „Hilfe“, Spezifikation 034).

  Aufbau:
    1. links das Programmicon in großer Darstellung (Vektorzeichnung ProgrammiconGross aus App.xaml)
    2. rechts untereinander: Programmname, Version, Autor und eine kurze Beschreibung
    3. unten rechts „OK“; Enter und Esc schließen ebenfalls (IsDefault und IsCancel)

  Alle Texte kommen aus dem UeberViewModel; das Fenster passt seine Größe dem Inhalt an.
-->
<Window x:Class="AndyTours.App.Views.UeberFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über AndyTours"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="24">

        <!-- 3. Schaltfläche -->
        <Button DockPanel.Dock="Bottom" Content="_OK" IsDefault="True" IsCancel="True" MinWidth="90" Padding="8,3"
                HorizontalAlignment="Right" Margin="0,20,0,0" Click="Ok_Click" />

        <!-- 1. Programmicon -->
        <Image DockPanel.Dock="Left" Source="{StaticResource ProgrammiconGross}" Width="128" Height="128"
               VerticalAlignment="Top" Margin="0,0,24,0" />

        <!-- 2. Angaben zum Programm -->
        <StackPanel VerticalAlignment="Center" MaxWidth="320">
            <TextBlock Text="{Binding Programmname}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Version}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Autor}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Beschreibung}" TextWrapping="Wrap" Foreground="Gray" Margin="0,12,0,0" />
        </StackPanel>

    </DockPanel>
</Window>
