<!--
  Fenster „Tourdetail“ für „Einheit → Tourdetail…“ und das Kontextmenü der Tabelle.

  Aufbau von oben nach unten:
    1. Kopfzeile: Datum, Name, Distanz, Höhenmeter und höchster Punkt der Einheit; bei mehreren Einheiten
       (Mehrtagestour) Zeitraum, Anzahl der Etappen und Summen, darunter ggf. die Etappen ohne Aufzeichnung
    2. Karteikarte „Höhenprofil“:
       a. Achsenwahl „Distanz“ / „Fahrzeit“ und Häkchen für Puls, Geschwindigkeit, Trittfrequenz und Temperatur
          (nicht wählbar, wenn die Aufzeichnung den Wert nicht enthält)
       b. ggf. Hinweis auf Etappen ohne Höhendaten
       c. Diagramm; ohne Höhendaten bzw. ohne jede Aufzeichnung stattdessen ein Hinweis
    3. Karteikarte „Karte“ (DataContext: Streckenkarte):
       a. Umschalter „OpenStreetMap“ / „OpenTopoMap“, Schaltflächen „Ganze Strecke“, „Als GPX exportieren…“
          (danach der Hinweis „Track exportiert: …“), „Auf Garmin übertragen…“ (als Course auf den Edge) und
          „Overlays…“ (öffnet die Overlay-Verwaltung), Zeichenerklärung
       b. ggf. Hinweis auf Etappen ohne GPS-Daten
       c. Karte mit Strecke (bei mehreren Etappen eine Linie je Etappe), Lizenzhinweis unten rechts und ggf. dem
          Hinweis, dass die Karte nicht geladen werden konnte; ohne GPS-Daten bzw. ohne jede Aufzeichnung stattdessen
          ein Hinweis
       d. unter der Karte die Leiste „Track bearbeiten“ (nur eine Einheit mit GPS-Daten): Regler „Start“ und „Ziel“,
          „Umkehren“, „Glätten“ (aus / schwach / stark), „Zurücksetzen“ und die Länge der bearbeiteten Strecke;
          die Karte, „Als GPX exportieren…“ und „Auf Garmin übertragen…“ verwenden dann die bearbeitete Strecke

  Das Fenster ist nicht modal: Das Hauptfenster bleibt bedienbar, mehrere Tourdetails können offen sein.
  Maus im Diagramm: Überfahren zeigt die Werte, mit der linken Taste einen Bereich aufziehen vergrößert ihn,
  ein Doppelklick zeigt wieder die ganze Tour.
  Maus auf der Karte: Mausrad vergrößert oder verkleinert an der Mausposition, Ziehen mit der linken Taste verschiebt.
  Die Karte selbst (Ebenen, Zwischenspeicher, Ausschnitt) baut das Code-Behind auf.
-->
<Window x:Class="AndyTours.App.Views.TourdetailFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:vm="clr-namespace:AndyTours.App.ViewModels"
        Title="Tourdetail"
        Width="900"
        Height="560"
        MinWidth="520"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Language="de-DE">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Hinweise auf Etappen ohne Aufzeichnung, Höhen- oder GPS-Daten -->
        <Style x:Key="Etappenhinweis" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A04000" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- 1. Kopfzeile -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Kopfzeile}" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding HinweisOhneAufzeichnung}" Style="{StaticResource Etappenhinweis}"
                   Visibility="{Binding HatHinweisOhneAufzeichnung, Converter={StaticResource SichtbarWennWahr}}" />

        <!-- 2. Karteikarten -->
        <TabControl>
            <TabItem Header="Höhenprofil">
                <DockPanel Margin="8">

                    <!-- 2a. Achsenwahl und Zusatzwerte -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding HatHoehe, Converter={StaticResource SichtbarWennWahr}}">
                        <TextBlock Text="Achse:" VerticalAlignment="Center" />
                        <RadioButton Content="_Distanz" GroupName="Achse" IsChecked="{Binding NachDistanz}" />
                        <RadioButton Content="_Fahrzeit" GroupName="Achse" IsChecked="{Binding NachFahrzeit}" />
                        <TextBlock Text="Einblenden:" VerticalAlignment="Center" Margin="24,0,0,0" />
                        <CheckBox Content="_Puls" IsChecked="{Binding ZeigePuls}" IsEnabled="{Binding KannPuls}" />
                        <CheckBox Content="_Geschwindigkeit" IsChecked="{Binding ZeigeGeschwindigkeit}" IsEnabled="{Binding KannGeschwindigkeit}" />
                        <CheckBox Content="_Trittfrequenz" IsChecked="{Binding ZeigeTrittfrequenz}" IsEnabled="{Binding KannTrittfrequenz}" />
                        <CheckBox Content="T_emperatur" IsChecked="{Binding ZeigeTemperatur}" IsEnabled="{Binding KannTemperatur}" />
                    </StackPanel>

                    <!-- 2b. Etappen ohne Höhendaten -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding HinweisOhneHoehe}" Style="{StaticResource Etappenhinweis}"
                               Visibility="{Binding HatHinweisOhneHoehe, Converter={StaticResource SichtbarWennWahr}}" />

                    <!-- 2c. Diagramm bzw. Hinweis ohne Höhendaten oder ohne Aufzeichnung -->
                    <Grid>
                        <oxy:PlotView Model="{Binding Diagramm}" Controller="{Binding Steuerung}"
                                      Visibility="{Binding HatHoehe, Converter={StaticResource SichtbarWennWahr}}" />
                        <TextBlock Text="{Binding HinweisOhneProfil}" Foreground="Gray" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding OhneHoehe, Converter={StaticResource SichtbarWennWahr}}" />
                    </Grid>

                </DockPanel>
            </TabItem>

            <!-- 3. Karte -->
            <TabItem Header="Karte" DataContext="{Binding Streckenkarte}">
                <DockPanel Margin="8">

                    <!-- 3a. Kartenart, „Ganze Strecke“, „Als GPX exportieren…“, „Auf Garmin übertragen…“, „Overlays…“ und Zeichenerklärung -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding HatStrecke, Converter={StaticResource SichtbarWennWahr}}">
                        <TextBlock Text="Karte:" VerticalAlignment="Center" />
                        <RadioButton Content="_OpenStreetMap" GroupName="Kartenart" IsChecked="{Binding IstOpenStreetMap}" />
                        <RadioButton Content="Open_TopoMap" GroupName="Kartenart" IsChecked="{Binding IstOpenTopoMap}" />
                        <Button Content="_Ganze Strecke" Command="{Binding GanzeStreckeCommand}" Padding="10,2" Margin="24,0,0,0" />
                        <Button Content="Als GP_X exportieren…" Command="{Binding GpxExportierenCommand}" Padding="10,2" Margin="8,0,0,0" />
                        <Button Content="Auf Garmin ü_bertragen…" Command="{Binding GarminUebertragenCommand}" Padding="10,2" Margin="8,0,0,0" />
                        <Button Content="O_verlays…" Click="OverlaysOeffnen_Click" Padding="10,2" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Exporthinweis}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" />
                        <TextBlock VerticalAlignment="Center" Margin="24,0,0,0" Foreground="Gray">
                            <Run Text="●" Foreground="#27AE60" /> Start
                            <Run Text="■" Foreground="#C0392B" /> Ziel
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"
                                   Visibility="{Binding MehrereEtappen, Converter={StaticResource SichtbarWennWahr}}">
                            <Run Text="•" Foreground="#555555" /> Etappenwechsel
                        </TextBlock>
                    </StackPanel>

                    <!-- 3b. Etappen ohne GPS-Daten -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding HinweisOhneGps}" Style="{StaticResource Etappenhinweis}"
                               Visibility="{Binding HatHinweisOhneGps, Converter={StaticResource SichtbarWennWahr}}" />

                    <!-- 3d. Leiste „Track bearbeiten“ (nur eine Einheit mit GPS-Daten): Regler für Start und Ziel mit
                         ihrer Stelle in km, Umkehren, Glätten, Zurücksetzen und die Länge der bearbeiteten Strecke -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding KannBearbeiten, Converter={StaticResource SichtbarWennWahr}}">
                        <TextBlock Text="Track bearbeiten:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="_Start" Target="{Binding ElementName=StartRegler}" VerticalAlignment="Center" Padding="0,0,4,0" />
                        <Slider x:Name="StartRegler" Width="160" VerticalAlignment="Center" Minimum="0" Maximum="{Binding LetzterPunkt}"
                                Value="{Binding Startpunkt}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="60" />
                        <TextBlock Text="{Binding StartKm, StringFormat='{}{0:N1} km'}" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                        <Label Content="_Ziel" Target="{Binding ElementName=ZielRegler}" VerticalAlignment="Center" Padding="0,0,4,0" Margin="16,0,0,0" />
                        <Slider x:Name="ZielRegler" Width="160" VerticalAlignment="Center" Minimum="0" Maximum="{Binding LetzterPunkt}"
                                Value="{Binding Zielpunkt}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="60" />
                        <TextBlock Text="{Binding ZielKm, StringFormat='{}{0:N1} km'}" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                        <CheckBox Content="_Umkehren" IsChecked="{Binding Umkehren}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBlock Text="Glätten:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <RadioButton Content="aus" GroupName="Glaettung" IsChecked="{Binding IstGlaettungAus}" VerticalAlignment="Center" />
                        <RadioButton Content="schwach" GroupName="Glaettung" IsChecked="{Binding IstGlaettungSchwach}" VerticalAlignment="Center" />
                        <RadioButton Content="stark" GroupName="Glaettung" IsChecked="{Binding IstGlaettungStark}" VerticalAlignment="Center" />
                        <Button Content="Zu_rücksetzen" Command="{Binding ZuruecksetzenCommand}" Padding="10,2" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding LaengeKm, StringFormat='Länge: {0:N1} km'}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>

                    <!-- 3c. Karte mit Hinweisen bzw. Hinweis ohne GPS-Daten oder ohne Aufzeichnung -->
                    <Grid>
                        <Grid Visibility="{Binding HatStrecke, Converter={StaticResource SichtbarWennWahr}}">
                            <mapsui:MapControl x:Name="Karte" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#C8FFFFFF" Padding="4,1">
                                <TextBlock Text="{Binding Lizenzhinweis}" FontSize="11" />
                            </Border>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Padding="8,4"
                                    Background="#F0FFF4E5" BorderBrush="#E67E22" BorderThickness="1"
                                    Visibility="{Binding Ladefehler, Converter={StaticResource SichtbarWennWahr}}">
                                <TextBlock Text="{x:Static vm:StreckenkarteViewModel.KarteNichtGeladen}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding HinweisOhneStrecke}" Foreground="Gray" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding OhneStrecke, Converter={StaticResource SichtbarWennWahr}}" />
                    </Grid>

                </DockPanel>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
