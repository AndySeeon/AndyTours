<!--
  Fenster „Equipment-Einsatz“ (Menü „Extras → Equipment-Einsatz…“).

  Aufbau von oben nach unten:
    1. Tabelle: je Equipment eine Zeile mit „vorher (km)“, „Gesamt (km)“ und „Gesamt (hm)“, danach ggf.
       „ohne Equipment“ und zuletzt „Summe“ (fett). Statt der Tabelle erscheint der Hinweis
       „Keine Einheiten vorhanden.“, wenn es keine Zeilen gibt.
    2. „Schließen“ (auch Esc)

  Datenquelle ist das EquipmentEinsatzViewModel. Die Tabelle ist schreibgeschützt. Das Sortieren übernimmt
  das Code-Behind (Ereignis Sorting), damit „Summe“ unten bleibt. Zahlen ohne Nachkommastellen (N0);
  leere Zellen stehen für 0.
-->
<Window x:Class="AndyTours.App.Views.EquipmentEinsatzFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment-Einsatz"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Language="de-DE">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />

        <!-- Zahlen rechtsbündig -->
        <Style x:Key="Zahl" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">

        <!-- 1. Tabelle bzw. Hinweis -->
        <DataGrid x:Name="Tabelle" ItemsSource="{Binding Zeilen}" MaxHeight="480"
                  Visibility="{Binding HatZeilen, Converter={StaticResource SichtbarWennWahr}}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0"
                  Sorting="Tabelle_Sorting">
            <!-- Zeile „Summe“ fett -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IstSumme}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="SpalteEquipment" Header="Equipment" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                <DataGridTextColumn x:Name="SpalteVorherKm" Header="vorher (km)" Width="110"
                                    Binding="{Binding VorherKm, Mode=OneWay, StringFormat='N0'}" ElementStyle="{StaticResource Zahl}" />
                <DataGridTextColumn x:Name="SpalteGesamtKm" Header="Gesamt (km)" Width="110" SortDirection="Descending"
                                    Binding="{Binding GesamtKm, Mode=OneWay, StringFormat='N0'}" ElementStyle="{StaticResource Zahl}" />
                <DataGridTextColumn x:Name="SpalteGesamtHm" Header="Gesamt (hm)" Width="110"
                                    Binding="{Binding GesamtHm, Mode=OneWay, StringFormat='N0'}" ElementStyle="{StaticResource Zahl}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Keine Einheiten vorhanden." Foreground="Gray" Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HatZeilen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 2. Schaltfläche -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Schließen" IsCancel="True" IsDefault="True" MinWidth="90" Padding="8,3" />
        </StackPanel>

    </StackPanel>
</Window>
