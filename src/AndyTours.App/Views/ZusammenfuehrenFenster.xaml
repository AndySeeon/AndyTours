<!--
  Fenster „Zusammenführen mit …“ aus den Einstellungen (Auswahllisten „Aktivität“ und „Kategorie“).

  Aufbau von oben nach unten:
    1. Erklärung, z. B. „‚Trainieren‘ zusammenführen mit:“
    2. Liste der übrigen Einträge derselben Liste; Doppelklick auf eine Zeile entspricht „OK“
    3. Schaltflächen „OK“ (nur mit Auswahl) und „Abbrechen“

  Das Fenster wählt nur aus. Die Rückfrage mit der Anzahl und das Zusammenführen folgen nach dem Schließen.
-->
<Window x:Class="AndyTours.App.Views.ZusammenfuehrenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zusammenführen mit"
        Width="320"
        Height="340"
        MinWidth="260"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- 1. Erklärung -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Erklaerung}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <!-- 3. Schaltflächen -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_OK" IsDefault="True" MinWidth="90" Padding="8,3" Margin="0,0,8,0"
                    Command="{Binding OkCommand}" />
            <Button Content="_Abbrechen" IsCancel="True" MinWidth="90" Padding="8,3" />
        </StackPanel>

        <!-- 2. Übrige Einträge -->
        <ListBox x:Name="Liste" ItemsSource="{Binding Ziele}" SelectedItem="{Binding Ausgewaehlt}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <EventSetter Event="MouseDoubleClick" Handler="Zeile_MouseDoubleClick" />
                    <Setter Property="Padding" Value="4,3" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

    </DockPanel>
</Window>
