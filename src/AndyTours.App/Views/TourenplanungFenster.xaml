<!--
  Fenster „Tour planen“ (Menü „Tourenplanung → Tour planen…“): neue Strecke per Mausklick auf der Karte planen.

  Aufbau von oben nach unten:
    1. Leiste: Fahrprofil, „Öffnen…“, „Speichern…“, „Letzten Punkt entfernen“, „Alles löschen“; rechts Länge,
       Höhenmeter und „Strecke wird ermittelt …“, solange der Routingdienst rechnet
    2. Unten: Bedienhinweis und ggf. ein roter Hinweis (z. B. Routingdienst nicht erreichbar)
    3. Karte (OpenStreetMap) mit Strecke, Abbiegepunkten und Wegpunkten; Lizenzhinweis unten rechts

  Die Karte füllt und bedient das Code-Behind (Mapsui kennt keine Bindungen). Das Fenster ist nicht modal; beim
  Schließen mit ungespeicherten Änderungen kommt eine Rückfrage.
-->
<Window x:Class="AndyTours.App.Views.TourenplanungFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="{Binding Fenstertitel}"
        Width="1100"
        Height="800"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />
    </Window.Resources>

    <DockPanel Margin="8">

        <!-- 1. Leiste -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Strecke wird ermittelt …" Foreground="Gray" Margin="0,0,16,0"
                           Visibility="{Binding ErmitteltGerade, Converter={StaticResource SichtbarWennWahr}}" />
                <TextBlock Text="{Binding LaengeText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HoehenmeterText}" Margin="16,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="_Fahrprofil:" Target="{Binding ElementName=ProfilAuswahl}" VerticalAlignment="Center" />
                <ComboBox x:Name="ProfilAuswahl" Width="230" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Fahrprofile}" DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding Profil}" />
                <Button Content="Ö_ffnen…" MinWidth="90" Padding="8,3" Margin="16,0,0,0" Command="{Binding OeffnenCommand}" />
                <Button Content="_Speichern…" MinWidth="90" Padding="8,3" Margin="6,0,0,0" Command="{Binding SpeichernCommand}" />
                <Button Content="_Letzten Punkt entfernen" Padding="8,3" Margin="16,0,0,0" Command="{Binding LetztenPunktEntfernenCommand}" />
                <Button Content="_Alles löschen" Padding="8,3" Margin="6,0,0,0" Command="{Binding AllesLoeschenCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- 2. Bedienhinweis und Hinweis -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock Foreground="Gray" TextWrapping="Wrap"
                       Text="Klick in die Karte: Wegpunkt anhängen · Wegpunkt ziehen: verschieben · Linie ziehen: Zwischenpunkt einfügen · Rechtsklick auf einen Wegpunkt: entfernen · Karte ziehen: verschieben" />
            <TextBlock Text="{Binding Hinweis}" Foreground="Firebrick" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 3. Karte -->
        <Grid>
            <mapsui:MapControl x:Name="Karte" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#C8FFFFFF" Padding="4,1" IsHitTestVisible="False">
                <TextBlock Text="© OpenStreetMap-Mitwirkende · Routing: BRouter bzw. openrouteservice" FontSize="11" />
            </Border>
        </Grid>

    </DockPanel>
</Window>
