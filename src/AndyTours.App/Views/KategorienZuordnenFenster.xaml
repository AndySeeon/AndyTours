<!--
  Fenster „Kategorien zuordnen“ (Menü „Einheit → Kategorien zuordnen…“ und Kontextmenü der Tabelle).

  Aufbau von oben nach unten:
    1. Erklärung mit der Anzahl der markierten Einheiten
    2. Alle Kategorien alphabetisch mit Häkchen: an = alle Einheiten haben sie, aus = keine, grau
       (teilweise) = nur manche. „Teilweise“ ist nur bei Kategorien wählbar, die anfangs so standen.
    3. „OK“ und „Abbrechen“

  Das Fenster wählt nur aus. Rückfrage und Speichern folgen nach dem Schließen im Hauptfenster.
-->
<Window x:Class="AndyTours.App.Views.KategorienZuordnenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategorien zuordnen"
        Width="360"
        Height="440"
        MinWidth="280"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- 1. Erklärung -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Erklaerung}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <!-- 3. Schaltflächen -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_OK" IsDefault="True" MinWidth="90" Padding="8,3" Margin="0,0,8,0" Command="{Binding OkCommand}" />
            <Button Content="_Abbrechen" IsCancel="True" MinWidth="90" Padding="8,3" />
        </StackPanel>

        <!-- 2. Kategorien mit dreistufigen Häkchen -->
        <ListBox x:Name="Liste" ItemsSource="{Binding Zeilen}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IstGewaehlt}" IsThreeState="{Binding KannTeilweise}" Margin="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
