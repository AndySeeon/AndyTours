<!--
  Auswahl der Sicherung für „Extras → Sicherung wiederherstellen…“.

  Aufbau von oben nach unten:
    1. Erklärung und Pfad des Sicherungsordners
    2. Liste der Sicherungen mit Wochentag, Datum und Uhrzeit, die neueste zuerst (vorausgewählt);
       Doppelklick auf eine Zeile entspricht „Wiederherstellen…“
    3. Schaltflächen „Wiederherstellen…“ (nur mit Auswahl) und „Abbrechen“

  Das Fenster wählt nur aus. Die Rückfrage und das Zurückspielen folgen erst nach dem Schließen.
-->
<Window x:Class="AndyTours.App.Views.SicherungAuswahlFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sicherung wiederherstellen"
        Width="460"
        Height="420"
        MinWidth="360"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- 1. Erklärung und Sicherungsordner -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap"
                       Text="Wählen Sie die Sicherung, auf deren Stand der Datenbestand zurückgesetzt werden soll:" />
            <TextBlock Text="{Binding Sicherungsordner}" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 3. Schaltflächen -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Wiederherstellen…" IsDefault="True" MinWidth="120" Padding="8,3" Margin="0,0,8,0"
                    Command="{Binding WiederherstellenCommand}" />
            <Button Content="_Abbrechen" IsCancel="True" MinWidth="90" Padding="8,3" />
        </StackPanel>

        <!-- 2. Liste der Sicherungen -->
        <ListBox x:Name="Liste" ItemsSource="{Binding Zeilen}" SelectedItem="{Binding Ausgewaehlt}"
                 DisplayMemberPath="Anzeigetext">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick" Handler="Zeile_MouseDoubleClick" />
                    <Setter Property="Padding" Value="4,3" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

    </DockPanel>
</Window>
