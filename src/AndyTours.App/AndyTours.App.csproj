<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AndyTours.Core\AndyTours.Core.csproj" />
    <ProjectReference Include="..\AndyTours.Daten\AndyTours.Daten.csproj" />
    <ProjectReference Include="..\AndyTours.Import\AndyTours.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MediaDevices" Version="2.0.0" />
    <PackageReference Include="Mapsui.Wpf" Version="5.1.0" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WPF0001: ThemeMode (Fluent-Design) ist in .NET 10 noch als experimentell gekennzeichnet.
         Wir verwenden es bewusst (ADR 0006); betroffen ist nur App.xaml. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Programmicon der exe; Fenster ohne eigenes Icon zeigen es in Titelleiste und Taskleiste (Spezifikation 034).
         Erzeugt wird die Datei mit tools/AndyTours.Programmicon/Erstelle-Programmicon.ps1. -->
    <ApplicationIcon>Ressourcen\AndyTours.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
