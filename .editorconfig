# Einheitliche Formatierung für alle Dateien der Solution.
# Visual Studio und der dotnet-Formatierer werten diese Datei automatisch aus.
root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,xaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Dateibezogene Namespaces (namespace X;) statt Block-Namespaces
csharp_style_namespace_declarations = file_scoped:suggestion
# var nur verwenden, wenn der Typ offensichtlich ist
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
# Geschweifte Klammern immer setzen, auch bei einzeiligen if-Anweisungen
csharp_prefer_braces = true:suggestion
# Private Felder mit Unterstrich beginnen (_feldName)
dotnet_naming_rule.private_felder.symbols = private_felder
dotnet_naming_rule.private_felder.style = unterstrich_camel
dotnet_naming_rule.private_felder.severity = suggestion
dotnet_naming_symbols.private_felder.applicable_kinds = field
dotnet_naming_symbols.private_felder.applicable_accessibilities = private
dotnet_naming_style.unterstrich_camel.capitalization = camel_case
dotnet_naming_style.unterstrich_camel.required_prefix = _
