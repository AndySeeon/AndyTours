<!--
  Gemeinsame Build-Einstellungen für alle Projekte der Solution.
  MSBuild liest diese Datei automatisch für jedes Projekt unterhalb dieses Ordners,
  dadurch müssen die Einstellungen nicht in jeder .csproj wiederholt werden.
-->
<Project>
  <PropertyGroup>
    <!-- Aktuelle C#-Sprachversion des installierten SDK verwenden -->
    <LangVersion>latest</LangVersion>
    <!-- Nullable-Referenztypen: der Compiler warnt vor möglichen null-Zugriffen -->
    <Nullable>enable</Nullable>
    <!-- Häufige using-Anweisungen (System, System.IO, System.Linq …) automatisch einbinden -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML-Dokumentationskommentare (///) auswerten, damit sie in IntelliSense erscheinen -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Warnung CS1591 ("fehlender XML-Kommentar") vorerst nicht als Fehler behandeln -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Eingebauter .NET-Analyzer: prüft den Code beim Build auf typische Fehler und Stilverstöße.
         Meldungen erscheinen als Warnungen (z. B. CA1822) – ein Klick darauf in Visual Studio führt zur Erklärung. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Auch die Stilregeln aus .editorconfig (IDExxxx) beim Build prüfen, nicht nur im Editor -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Programmversion (Major.Minor.Patch); 0.x = Entwicklungsstand vor der ersten nutzbaren Version -->
    <Version>1.0.0</Version>
    <!-- Gemeinsame Produktangaben für alle Assemblies -->
    <Product>AndyTours</Product>
    <Authors>Andreas Hensel</Authors>
    <Company>AndyTours</Company>
    <!-- Autor in den Dateieigenschaften der exe; das Fenster „Über AndyTours“ liest ihn von dort (Spezifikation 034) -->
    <Copyright>© Andreas Hensel</Copyright>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>
</Project>
