<!--
  Gemeinsame Build-Einstellungen für alle Projekte der Solution.
  MSBuild liest diese Datei automatisch für jedes Projekt unterhalb dieses Ordners,
  dadurch müssen die Einstellungen nicht in jeder .csproj wiederholt werden.
-->
<Project>
  <PropertyGroup>
    <!-- Aktuelle C#-Sprachversion des installierten SDK verwenden -->
    <LangVersion>latest</LangVersion>
    <!-- Nullable-Referenztypen: der Compiler warnt vor möglichen null-Zugriffen -->
    <Nullable>enable</Nullable>
    <!-- Häufige using-Anweisungen (System, System.IO, System.Linq …) automatisch einbinden -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML-Dokumentationskommentare (///) auswerten, damit sie in IntelliSense erscheinen -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Warnung CS1591 ("fehlender XML-Kommentar") vorerst nicht als Fehler behandeln -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Programmversion (Major.Minor.Patch); 0.x = Entwicklungsstand vor der ersten nutzbaren Version -->
    <Version>0.1.0</Version>
    <!-- Gemeinsame Produktangaben für alle Assemblies -->
    <Product>RadlDB</Product>
    <Authors>Andreas Hensel</Authors>
    <Company>RadlDB</Company>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>
</Project>
